{
  "name": "seraph-01-realtime", "version": "1.0.0", "private": true, "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1", "build": "tsc -b && vite build", "preview": "vite preview --host 127.0.0.1",
    "export:model": "blender -b ../seraph-01/seraph-01.blend --python-exit-code 1 --python scripts/export_blender.py",
    "optimize:model": "node scripts/optimize-model.mjs", "verify:model": "node scripts/verify-model.mjs", "verify:runtime": "node scripts/verify-runtime.mjs"
  },
  "dependencies": {
    "react": "^19.2.0", "react-dom": "^19.2.0", "three": "^0.184.0",
    "@react-three/fiber": "^9.8.1", "@react-three/drei": "^10.7.9",
    "@react-three/postprocessing": "^3.2.0", "postprocessing": "^6.38.0", "meshoptimizer": "^1.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "@types/three": "^0.184.0",
    "typescript": "^5.9.0", "vite": "^8.3.4", "@vitejs/plugin-react": "^6.0.0",
    "@gltf-transform/core": "^4.3.0", "@gltf-transform/extensions": "^4.3.0", "@gltf-transform/functions": "^4.3.0",
    "gltf-validator": "^2.0.0-dev.3.10"
  }
